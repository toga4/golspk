{
  "name": "golspk",
  "displayName": "golspk",
  "description": "%description%",
  "version": "0.9.1",
  "publisher": "toga4",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/toga4/golspk"
  },
  "keywords": [
    "go",
    "golang",
    "lsp",
    "language server"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:go"
  ],
  "main": "./extension.js",
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "golspk.restart",
        "title": "%command.restart%"
      },
      {
        "command": "golspk.referencesAllModules",
        "title": "%command.referencesAllModules%"
      },
      {
        "command": "golspk.implementationsAllModules",
        "title": "%command.implementationsAllModules%"
      },
      {
        "command": "golspk.widenLastSearch",
        "title": "%command.widenLastSearch%"
      },
      {
        "command": "golspk.toggleExcludeTests",
        "title": "%command.toggleExcludeTests%"
      }
    ],
    "configuration": {
      "title": "golspk",
      "properties": {
        "golspk.serverPath": {
          "type": "string",
          "default": "",
          "description": "%config.serverPath%"
        },
        "golspk.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "%config.exclude%"
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "command": "golspk.referencesAllModules",
          "when": "editorLangId == go",
          "group": "navigation@90"
        },
        {
          "command": "golspk.implementationsAllModules",
          "when": "editorLangId == go",
          "group": "navigation@91"
        }
      ]
    }
  },
  "scripts": {
    "build-go": "cd .. && CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o vscode/bin/golspk .",
    "package": "npm run build-go && vsce package --target darwin-arm64",
    "test": "node test/l10n-check.js && npm run build-go && node test/run.js --fixture"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.1"
  }
}
