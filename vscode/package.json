{
  "name": "golspk",
  "displayName": "golspk",
  "description": "%description%",
  "version": "0.2.0",
  "publisher": "toga4",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/toga4/golspk"
  },
  "keywords": [
    "go",
    "golang",
    "lsp",
    "language server"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:go"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "golspk.restart",
        "title": "%command.restart%"
      },
      {
        "command": "golspk.referencesAllModules",
        "title": "%command.referencesAllModules%"
      },
      {
        "command": "golspk.implementationsAllModules",
        "title": "%command.implementationsAllModules%"
      },
      {
        "command": "golspk.widenLastSearch",
        "title": "%command.widenLastSearch%"
      },
      {
        "command": "golspk.toggleExcludeTests",
        "title": "%command.toggleExcludeTests%"
      }
    ],
    "configuration": {
      "title": "golspk",
      "properties": {
        "golspk.serverPath": {
          "type": "string",
          "default": "",
          "description": "%config.serverPath%"
        },
        "golspk.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "%config.exclude%"
        },
        "golspk.trimAfterMinutes": {
          "type": "number",
          "default": 2,
          "minimum": 0,
          "description": "%config.trimAfterMinutes%"
        },
        "golspk.unloadAfterMinutes": {
          "type": "number",
          "default": 10,
          "minimum": 0,
          "description": "%config.unloadAfterMinutes%"
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "command": "golspk.referencesAllModules",
          "when": "editorLangId == go",
          "group": "navigation@90"
        },
        {
          "command": "golspk.implementationsAllModules",
          "when": "editorLangId == go",
          "group": "navigation@91"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "node -e \"for (const f of ['README.md', 'CHANGELOG.md']) require('node:fs').copyFileSync('../' + f, f)\" && npm run bundle",
    "bundle": "esbuild extension.js --bundle --platform=node --format=cjs --external:vscode --minify --outfile=dist/extension.js",
    "build-go": "cd .. && CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o vscode/bin/golspk .",
    "package": "npm run build-go && vsce package --no-dependencies --target darwin-arm64",
    "test": "node test/l10n-check.js && npm run build-go && npm run bundle && node test/run.js --fixture"
  },
  "devDependencies": {
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "vscode-languageclient": "^11.0.0"
  }
}
