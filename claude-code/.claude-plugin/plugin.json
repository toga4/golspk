{
  "name": "golspk",
  "description": "Fast, read-only Go language server for reading code",
  "author": {
    "name": "toga4"
  },
  "homepage": "https://github.com/toga4/golspk",
  "repository": "https://github.com/toga4/golspk",
  "license": "MIT",
  "keywords": ["go", "lsp"],
  "lspServers": {
    "golspk": {
      "command": "golspk",
      "extensionToLanguage": {
        ".go": "go"
      },
      "diagnostics": false
    }
  }
}
